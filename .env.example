# Copia este archivo a .env y llena los valores.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# MapTiler → Account → API keys. Restringe la key a tu dominio.
VITE_MAPTILER_KEY=xxxxxxxxxxxxxxxx

# OpenRouteService → openrouteservice.org/dev → API key.
# SIN prefijo VITE_: se queda en el servidor, nunca llega al navegador.
ORS_API_KEY=xxxxxxxxxxxxxxxx
